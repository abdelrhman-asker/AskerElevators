{
  "name": "@elevator/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/start-server.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import=tsx src/start-server.ts",
    "build": "tsc --project tsconfig.build.json",
    "vercel-build": "npm run build --workspace @elevator/shared",
    "start": "node dist/start-server.js",
    "lint": "eslint index*.ts src --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --exclude src/db/check.integration.test.ts",
    "test:db": "vitest run src/db/check.integration.test.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:check": "node --env-file-if-exists=../../.env --import=tsx src/db/check.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "@elevator/shared": "^0.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
