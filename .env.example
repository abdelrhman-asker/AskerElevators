# API runtime
NODE_ENV=development
PORT=3100
WEB_ORIGIN=http://localhost:5173

# Local PostgreSQL development service
# Copy this file to .env, then replace the password in both values below.
POSTGRES_DB=elevator_platform
POSTGRES_USER=elevator_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://elevator_app:replace-with-a-local-password@localhost:55432/elevator_platform
